  "definitions": {
    "MisleadingRetrievalRate": "cited lessons whose source training task belongs to the task's decoy_family / all cited lessons, over tasks annotated with decoy_family; null if no lesson was cited",
    "CorrectFamilyRetrievalRate": "cited lessons from the task's true family / all cited lessons on misleading tasks",
    "MisleadingExposureRate": "exposed decoy-family lessons / all exposed lessons on misleading tasks; TEXT_HISTORY exposes every lesson, so this is 1/3 by construction there",
    "cited": "lessons named by decision.memory_ids (what the selection actually used)",
    "exposed": "lessons in retrieval.memories (what the solver received)",
    "IterationDeltaVsNoMemory": "mean(iterations - paired NO_MEMORY iterations); negative is favourable; null if unpaired"
  }
