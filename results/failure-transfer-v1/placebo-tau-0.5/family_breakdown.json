  "definitions": {
    "original": "transfer tasks without decoy_family (EXP-04..06): the public text is lexically closest to the correct family, so success does not show causal transfer over lexical cues",
    "misleading": "transfer tasks with decoy_family (EXP-07..09): the public text imitates a decoy family; opposite interpretation, never pooled with original",
    "cell": "runs = transfer runs of that family and condition over all seeds and replicates; rates = numerator / runs",
    "LearningGain": "metric(condition) - metric(NO_MEMORY) in the same cell; negative IterationsPerTask is favourable, positive FirstAttemptSuccessRate is favourable"
  }
